---
interface Props {
  network: 'instagram' | 'tiktok' | 'youtube' | 'facebook';
  href: string;
  label: string;
}

const { network, href, label } = Astro.props;
const paths = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/>',
  tiktok: '<path d="M15 4v10.2a4.2 4.2 0 1 1-3.5-4.1"/><path d="M15 4c.8 2.4 2.2 3.7 4.5 4"/>',
  youtube: '<rect x="3" y="6" width="18" height="12" rx="3"/><path d="m10 9 5 3-5 3z" fill="currentColor" stroke="none"/>',
  facebook: '<path d="M14 21v-8h2.8l.4-3H14V8.2c0-.9.3-1.5 1.6-1.5h1.7V4a21 21 0 0 0-2.5-.2C12.3 3.8 11 5.2 11 7.7V10H8v3h3v8h3z" fill="currentColor" stroke="none"/>'
};
---
<a class="social-link" href={href} target="_blank" rel="noreferrer" aria-label={label} title={label}>
  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={paths[network]}></svg>
</a>
