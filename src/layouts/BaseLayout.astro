---
import { navigation, site } from '../data/site';
import SocialIcon from '../components/SocialIcon.astro';

const { title = `${site.name} | Producción musical`, description = 'JNSTUDIO: producción musical, ingeniería de sonido y desarrollo creativo para artistas.' } = Astro.props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0f" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="JNSTUDIO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={`https://javiernaranjomusic.com${Astro.url.pathname}`} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      @import url('../../styles.css');
      @import url('../../styles-overrides.css');
    </style>
  </head>
  <body>
    <div class="ambient ambient-one"></div><div class="ambient ambient-two"></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="JNSTUDIO, página de inicio"><span class="brand-mark">JN</span><span><b>JN</b>STUDIO</span></a>
      <nav class="main-nav" aria-label="Navegación principal">
        {navigation.map((item) => <a class:list={{ active: currentPath === item.href }} href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <SocialIcon network="instagram" href={site.instagram} label="Instagram" />
        <SocialIcon network="tiktok" href={site.tiktok} label="TikTok" />
        <SocialIcon network="youtube" href={site.youtube} label="YouTube" />
        <button class="cart-trigger" id="cart-trigger" type="button" aria-label="Abrir carrito" title="Abrir carrito"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h2l2 11h9l2-8H7"/><circle cx="10" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg><b id="cart-count">0</b></button>
        <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menú">☰</button>
      </div>
    </header>
    <button class="scroll-top" id="scroll-top" type="button" aria-label="Volver al inicio de la página" title="Volver arriba">↑</button>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-top">
        <div><a class="brand footer-brand" href="/"><span class="brand-mark">JN</span><span><b>JN</b>STUDIO</span></a><p class="footer-intro">Ideas que suenan. Historias que permanecen.</p></div>
        <div><p class="footer-label">Explora</p>{navigation.slice(1, 4).map((item) => <a href={item.href}>{item.label}</a>)}</div>
        <div><p class="footer-label">Contacto</p><a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a><span class="footer-meta">{site.city} · {site.hours}</span><a href="/contacto/">Abrir conversación</a></div>
        <div><p class="footer-label">Síguenos</p><div class="footer-socials"><SocialIcon network="instagram" href={site.instagram} label="Instagram" /><SocialIcon network="tiktok" href={site.tiktok} label="TikTok" /><SocialIcon network="facebook" href={site.facebook} label="Facebook" /><SocialIcon network="youtube" href={site.youtube} label="YouTube" /><SocialIcon network="portfolio" href={site.portfolio} label="Portfolio" /></div></div>
      </div>
      <div class="footer-bottom"><span>© 2026 JNSTUDIO. Todos los derechos reservados.</span><a href="/privacidad/">Privacidad</a><span>Sevilla / Online</span></div>
    </footer>
    <aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-labelledby="cart-title">
      <div class="cart-drawer-head"><div><p class="eyebrow">Tu selección</p><h2 id="cart-title">Carrito</h2></div><button class="cart-close" id="cart-close" type="button" aria-label="Cerrar carrito">×</button></div>
      <div id="cart-items"><p class="cart-empty">Todavía no has añadido ningún servicio.</p></div>
      <div class="cart-total"><span>Total</span><strong id="cart-total">0€</strong></div>
      <button class="cart-notes-trigger" id="cart-notes-trigger" type="button"><span>＋</span> Añadir indicaciones para tu proyecto</button>
      <button class="button button-primary full-width" id="cart-contract" type="button">Revisar contratación <span>↗</span></button>
      <button class="button button-ghost full-width payment-pending" id="cart-payment" type="button" disabled aria-disabled="true">Pago seguro próximamente <span>🔒</span></button>
      <p class="payment-note">El pago online se activará al conectar Stripe. Primero revisamos tu pedido y disponibilidad.</p>
    </aside>
    <div class="cart-backdrop" id="cart-backdrop"></div>
    <div class="cart-notes-dialog" id="cart-notes-dialog" aria-hidden="true"><div class="cart-notes-dialog-inner"><button class="cart-notes-close" id="cart-notes-close" type="button" aria-label="Cerrar indicaciones">×</button><p class="eyebrow">Personaliza tu solicitud</p><h2>¿Cómo quieres tu proyecto?</h2><p>Escribe referencias, ideas de sonido o cualquier detalle que deba conocer el equipo.</p><textarea id="cart-observation" placeholder="Ejemplo: voz cercana, referencias urbanas, entrega para lanzamiento..."></textarea><button class="button button-primary full-width" id="save-cart-notes" type="button">Guardar indicaciones <span>✓</span></button></div></div>
    <div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>
    <script is:inline>
      const menu = document.querySelector('#menu-toggle');
      menu?.addEventListener('click', () => document.querySelector('.main-nav')?.classList.toggle('open'));
      const cartDrawer = document.querySelector('#cart-drawer');
      const cartBackdrop = document.querySelector('#cart-backdrop');
      const cartItems = JSON.parse(localStorage.getItem('jnstudio-cart') || '[]');
      const renderCart = () => { const target = document.querySelector('#cart-items'); const total = document.querySelector('#cart-total'); if (!target || !total) return; target.innerHTML = cartItems.length ? cartItems.map((item, index) => `<div class="cart-item"><div><strong>${item.name}</strong><small>${item.price === 0 ? 'Precio a consultar' : `${item.price}€`}</small></div><button type="button" data-remove-cart="${index}" aria-label="Quitar ${item.name}">×</button></div>`).join('') : '<p class="cart-empty">Todavía no has añadido ningún servicio.</p>'; total.textContent = `${cartItems.reduce((sum, item) => sum + item.price, 0)}€`; document.querySelectorAll('[data-remove-cart]').forEach((button) => button.addEventListener('click', () => { cartItems.splice(Number(button.dataset.removeCart), 1); localStorage.setItem('jnstudio-cart', JSON.stringify(cartItems)); updateCartCount(); renderCart(); })); };
      const openCart = () => { cartDrawer?.classList.add('open'); cartBackdrop?.classList.add('open'); cartDrawer?.setAttribute('aria-hidden', 'false'); renderCart(); };
      const closeCart = () => { cartDrawer?.classList.remove('open'); cartBackdrop?.classList.remove('open'); cartDrawer?.setAttribute('aria-hidden', 'true'); };
      const updateCartCount = () => { const counter = document.querySelector('#cart-count'); if (counter) counter.textContent = String(cartItems.length); };
      document.querySelector('#cart-trigger')?.addEventListener('click', openCart);
      const notesDialog = document.querySelector('#cart-notes-dialog');
      const notesField = document.querySelector('#cart-observation');
      const notesTrigger = document.querySelector('#cart-notes-trigger');
      const closeNotes = () => { notesDialog?.classList.remove('open'); notesDialog?.setAttribute('aria-hidden', 'true'); };
      notesTrigger?.addEventListener('click', () => { if (notesField) notesField.value = localStorage.getItem('jnstudio-cart-observation') || ''; notesDialog?.classList.add('open'); notesDialog?.setAttribute('aria-hidden', 'false'); });
      document.querySelector('#cart-notes-close')?.addEventListener('click', closeNotes);
      document.querySelector('#save-cart-notes')?.addEventListener('click', () => { localStorage.setItem('jnstudio-cart-observation', notesField?.value || ''); closeNotes(); });
      document.querySelector('#cart-contract')?.addEventListener('click', () => { window.location.href = '/contacto/'; });
      document.querySelector('#cart-close')?.addEventListener('click', closeCart); cartBackdrop?.addEventListener('click', closeCart);
      document.addEventListener('click', (event) => { const button = event.target.closest('[data-add-cart]'); if (!button) return; cartItems.push({ name: button.dataset.name, price: Number(button.dataset.price || 0), category: button.dataset.category || 'general' }); localStorage.setItem('jnstudio-cart', JSON.stringify(cartItems)); updateCartCount(); openCart(); });
      updateCartCount();
      const scrollTop = document.querySelector('#scroll-top');
      const updateScrollTop = () => scrollTop?.classList.toggle('visible', window.scrollY > 360);
      window.addEventListener('scroll', updateScrollTop, { passive: true });
      updateScrollTop();
      scrollTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      document.addEventListener('mousemove', (event) => { const cursor = document.querySelector('#cursor-glow'); if (cursor) { cursor.style.left = `${event.clientX}px`; cursor.style.top = `${event.clientY}px`; } });
      setInterval(() => { const note = document.createElement('span'); note.className = 'music-note'; note.textContent = Math.random() > .5 ? '♪' : '♫'; note.style.left = `${Math.random() * 100}vw`; document.body.append(note); setTimeout(() => note.remove(), 9000); }, 1800);
    </script>
  </body>
</html>
